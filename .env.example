# =============================================================================
# System Demo - Variaveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de rodar.
# NUNCA versione o arquivo .env real.

# Banco de Dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/systemdemo
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=producao

# Seguranca
JWT_SECRET=systemdemo-secret-change-in-production-32ch

# Servidor
PORT=8080

# CORS
CORS_ORIGENS=http://localhost:4200

# Empresa (usado no PDF da Folha de Hora)
EMPRESA_NOME=TechFrame Tecnologia Ltda
EMPRESA_CNPJ=12.345.678/0001-90

# Spring Profiles
SPRING_PROFILES_ACTIVE=default

# Rate Limiting (Login)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
